<Window x:Class="MedicalReportEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MedicalReportEditor.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Medical Report Template Editor"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="Padding"
                    Value="10,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="Padding"
                    Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="Padding"
                    Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#2E86C1"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Hospital"
                                         Width="32"
                                         Height="32"
                                         Foreground="White"
                                         Margin="0,0,10,0"/>
                <TextBlock Text="Medical Report Editor"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Separator Width="20"
                           Visibility="Hidden"/>

                <TextBlock Text="{Binding HospitalInfo.HospitalName}"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Templates -->
            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Template Actions -->
                    <StackPanel Grid.Row="0"
                                Margin="10">
                        <Button Content="New Template"
                                Command="{Binding CreateNewTemplateCommand}"
                                Background="#27AE60"
                                Foreground="White"/>

                        <Button Content="Delete Template"
                                Command="{Binding DeleteTemplateCommand}"
                                Background="#E74C3C"
                                Foreground="White"
                                Margin="0,5,0,0"/>

                        <Separator Margin="0,10,0,5"/>

                        <TextBlock Text="Templates:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                    </StackPanel>

                    <!-- Template List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             DisplayMemberPath="Name"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="10,0,10,10"/>

                    <!-- Settings -->
                    <Border Grid.Row="2"
                            Background="#F5F5F5"
                            Padding="10">
                        <Button Content="Hospital Settings"
                                Command="{Binding OpenHospitalSettingsCommand}"
                                HorizontalAlignment="Stretch">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Settings"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,5,0"/>
                                        <TextBlock Text="Hospital Settings"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel - Editor -->
            <TabControl Grid.Column="1"
                        Margin="10">
                <TabItem Header="Report Editor">
                    <local:ReportEditorView/>
                </TabItem>

                <TabItem Header="Patient Data">
                    <ScrollViewer>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Patient ID -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Patient ID:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding PatientData.PatientId}"
                                     Width="200"
                                     Margin="0,0,0,5"/>

                            <!-- Patient Name -->
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Patient Name:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding PatientData.PatientName}"
                                     Width="300"
                                     Margin="0,0,0,5"/>

                            <!-- Age/Gender -->
                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Age/Gender:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding PatientData.AgeGender}"
                                     Width="200"
                                     Margin="0,0,0,5"/>

                            <!-- Visit Date -->
                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Visit Date:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>
                            <DatePicker Grid.Row="3"
                                        Grid.Column="1"
                                        SelectedDate="{Binding PatientData.VisitDate}"
                                        Width="150"
                                        Margin="0,0,0,5"/>

                            <!-- Referred By -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Referred by:"
                                       VerticalAlignment="Center"
                                       Margin="10,0,5,5"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="3"
                                     Text="{Binding PatientData.ReferredBy}"
                                     Width="200"
                                     Margin="0,0,0,5"/>

                            <!-- Consulted By -->
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Consulted by:"
                                       VerticalAlignment="Center"
                                       Margin="10,0,5,5"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Text="{Binding PatientData.ConsultedBy}"
                                     Width="200"
                                     Margin="0,0,0,5"/>

                            <!-- Procedure Type -->
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Procedure:"
                                       VerticalAlignment="Center"
                                       Margin="10,0,5,5"/>
                            <ComboBox Grid.Row="2"
                                      Grid.Column="3"
                                      ItemsSource="{Binding ReportTypes}"
                                      SelectedItem="{Binding PatientData.ProcedureType}"
                                      Width="200"
                                      Margin="0,0,0,5"/>

                            <!-- Premedication -->
                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Premedication:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Text="{Binding PatientData.Premedication}"
                                     Margin="0,0,0,5"/>

                            <!-- Instrument -->
                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Instrument:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>
                            <TextBox Grid.Row="5"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Text="{Binding PatientData.Instrument}"
                                     Margin="0,0,0,5"/>

                            <!-- Impression -->
                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="Impression:"
                                       VerticalAlignment="Top"
                                       Margin="0,10,5,0"/>
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Text="{Binding PatientData.Impression}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="100"
                                     Margin="0,10,0,0"/>

                            <!-- Biopsy -->
                            <CheckBox Grid.Row="7"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Content="Biopsy Taken"
                                      IsChecked="{Binding PatientData.BiopsyTaken}"
                                      Margin="0,10,0,0"/>

                            <TextBox Grid.Row="7"
                                     Grid.Column="2"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding PatientData.BiopsyResult}"
                                     IsEnabled="{Binding PatientData.BiopsyTaken}"
                                     Margin="10,10,0,0"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="PDF Preview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="10">
                            <Button Content="Preview PDF"
                                    Command="{Binding PreviewPdfCommand}"
                                    Background="#3498DB"
                                    Foreground="White"
                                    Padding="15,8"/>

                            <Button Content="Export PDF..."
                                    Command="{Binding ExportPdfCommand}"
                                    Background="#2ECC71"
                                    Foreground="White"
                                    Margin="10,0,0,0"
                                    Padding="15,8"/>

                            <Button Content="Crop Image..."
                                    Command="{Binding OpenImageCropCommand}"
                                    Margin="10,0,0,0"
                                    Padding="15,8">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Crop"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Margin="0,0,5,0"/>
                                            <TextBlock Text="Crop Image"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="1"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                Margin="10"
                                Background="White">
                            <TextBlock Text="PDF Preview will open in your default PDF viewer"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="Gray"/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#34495E"
                Height="30">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
