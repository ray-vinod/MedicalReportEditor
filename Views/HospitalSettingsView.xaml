<Window x:Class="MedicalReportEditor.Views.HospitalSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Hospital Settings"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="HospitalBuilding"
                                     Width="32"
                                     Height="32"
                                     Margin="0,0,10,0"/>
            <TextBlock Text="Hospital Information Settings"
                       FontSize="18"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Hospital Name -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Hospital Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding HospitalName}"
                         Margin="0,0,0,10"/>

                <!-- Hospital Address -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Hospital Address:"
                           VerticalAlignment="Top"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding HospitalAddress}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"
                         Margin="0,0,0,10"/>

                <!-- Contact Number -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Contact Number:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding ContactNumber}"
                         Margin="0,0,0,10"/>

                <!-- Report Header -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Report Header:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding ReportHeader}"
                         Margin="0,0,0,10"/>

                <!-- Email Address -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Email Address:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding EmailAddress}"
                         Margin="0,0,0,10"/>

                <!-- Website -->
                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Website:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Text="{Binding Website}"
                         Margin="0,0,0,10"/>

                <!-- Fax Number -->
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Fax Number:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Text="{Binding FaxNumber}"
                         Margin="0,0,0,10"/>

                <!-- Logo Path -->
                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Logo Path:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <Grid Grid.Row="7"
                      Grid.Column="1"
                      Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding HospitalLogoPath}"
                             IsReadOnly="True"/>

                    <Button Grid.Column="1"
                            Content="Browse..."
                            Command="{Binding BrowseLogoCommand}"
                            Margin="5,0,0,0"/>
                </Grid>

                <!-- Logo Preview -->
                <Border Grid.Row="8"
                        Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Height="150"
                        Background="White"
                        Margin="0,0,0,20">
                    <Image Source="{Binding LogoPreview}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="80"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"/>

                <Button Content="Save"
                        Width="80"
                        Command="{Binding SaveCommand}"
                        Background="#2E86C1"
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>