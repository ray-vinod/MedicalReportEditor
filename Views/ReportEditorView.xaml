<UserControl x:Class="MedicalReportEditor.Views.ReportEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0"
                 Background="#F5F5F5"
                 Height="40">
            <ComboBox ItemsSource="{Binding Templates}"
                      SelectedItem="{Binding SelectedTemplateName}"
                      DisplayMemberPath="Name"
                      Width="200"
                      Margin="5,0"/>

            <Separator/>

            <Button ToolTip="Save (Ctrl+S)"
                    Command="{Binding SaveTemplateCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave"
                                             Width="16"
                                             Height="16"/>
                    <TextBlock Text="Save"
                               Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Button ToolTip="Validate XML"
                    Command="{Binding ValidateXmlCommand}">
                <materialDesign:PackIcon Kind="CheckCircleOutline"/>
            </Button>

            <Button ToolTip="Format XML"
                    Command="{Binding FormatXmlCommand}">
                <materialDesign:PackIcon Kind="FormatIndentIncrease"/>
            </Button>

            <Separator/>

            <Button ToolTip="Undo (Ctrl+Z)"
                    Command="{Binding UndoCommand}">
                <materialDesign:PackIcon Kind="Undo"/>
            </Button>

            <Button ToolTip="Redo (Ctrl+Y)"
                    Command="{Binding RedoCommand}">
                <materialDesign:PackIcon Kind="Redo"/>
            </Button>

            <Separator/>

            <TextBlock Text="Paper Size:"
                       VerticalAlignment="Center"
                       Margin="10,0,5,0"/>
            <ComboBox ItemsSource="{Binding PaperSizes}"
                      SelectedItem="{Binding SelectedPaperSize}"
                      DisplayMemberPath="Name"
                      Width="150"/>
        </ToolBar>

        <!-- XML Editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- AvalonEdit XML Editor -->
            <avalonEdit:TextEditor Grid.Column="0"
                                   x:Name="XmlEditor"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   ShowLineNumbers="True"
                                   SyntaxHighlighting="XML"
                                   WordWrap="False"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto">
                <avalonEdit:TextEditor.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Cut"
                                  Command="Cut"/>
                        <MenuItem Header="Copy"
                                  Command="Copy"/>
                        <MenuItem Header="Paste"
                                  Command="Paste"/>
                        <Separator/>
                        <MenuItem Header="Format XML"
                                  Command="{Binding FormatXmlCommand}"/>
                        <MenuItem Header="Validate XML"
                                  Command="{Binding ValidateXmlCommand}"/>
                    </ContextMenu>
                </avalonEdit:TextEditor.ContextMenu>
            </avalonEdit:TextEditor>

            <!-- Properties Panel -->
            <Border Grid.Column="1"
                    BorderBrush="LightGray"
                    BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Template Properties"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Selected Template:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SelectedTemplateName}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Paper Size:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding PaperSizes}"
                                  SelectedItem="{Binding SelectedPaperSize}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="Font Family:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding FontFamilies}"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="Validation Status:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <Border Background="{Binding IsValidXml, Converter={StaticResource BoolToColorConverter}}"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,0,0,15">
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="Unsaved Changes:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding IsDirty, Converter={StaticResource BoolToTextConverter}}"
                                   Foreground="{Binding IsDirty, Converter={StaticResource BoolToForegroundConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#ECF0F1"
                Height="25">
            <TextBlock Text="{Binding ValidationMessage}"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>