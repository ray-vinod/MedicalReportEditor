<Application x:Class="MedicalReportEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MedicalReportEditor.Converters"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Boolean to Color Converter -->
        <local:BoolToColorConverter x:Key="BoolToColorConverter"
                                    TrueColor="Green"
                                    FalseColor="Red"/>

        <!-- Boolean to Text Converter -->
        <local:BoolToTextConverter x:Key="BoolToTextConverter"
                                   TrueText="Yes"
                                   FalseText="No"/>

        <!-- Boolean to Foreground Converter -->
        <local:BoolToForegroundConverter x:Key="BoolToForegroundConverter"
                                         TrueColor="Red"
                                         FalseColor="Black"/>
    </Application.Resources>
</Application>
